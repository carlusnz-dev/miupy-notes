# Copie para .env.local (ignorado no Git) e preencha. Nunca versione os valores.
# Cliente OAuth "Desktop app" do Google. Lido pela API (aud) e pelo Rust em runtime.
GOOGLE_CLIENT_ID=
# Lido só pelo Rust em runtime, se o Google exigir na troca do code. Nunca no bundle web.
GOOGLE_CLIENT_SECRET=
# sub do proprietário, separados por vírgula. Vazio: a API responde 403 a todos.
ALLOWED_SUBS=
