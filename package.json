{
  "name": "miupy-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @miupy-notes/web",
    "dev:api": "npm run dev --workspace @miupy-notes/api",
    "dev:db": "docker run --rm -d --name miupy-dynamodb -u root -p 127.0.0.1:8000:8000 -v miupy-dynamodb:/home/dynamodblocal/data amazon/dynamodb-local:3.3.1 -jar DynamoDBLocal.jar -sharedDb -dbPath ./data",
    "db:create-table": "npm run db:create-table --workspace @miupy-notes/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace @miupy-notes/web",
    "build:api": "npm run build --workspace @miupy-notes/api",
    "test:api": "npm run test --workspace @miupy-notes/api",
    "check:modules": "npm run check:modules --workspace @miupy-notes/api",
    "preview": "npm run preview --workspace @miupy-notes/web",
    "tauri": "tauri",
    "tauri:dev:wayland": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
