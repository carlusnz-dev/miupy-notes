{
  "version": 1,
  "status": "partial-verified",
  "root": "apps/api/src",
  "runtime": {
    "httpFramework": "express",
    "validation": "zod",
    "databaseClient": "@aws-sdk/lib-dynamodb",
    "lambdaAdapter": "serverless-http",
    "publicRoutes": ["GET /health"],
    "unmountedRoutes": ["GET /v1/notes", "POST /v1/notes", "GET /v1/notes/:id", "PATCH /v1/notes/:id", "DELETE /v1/notes/:id"],
    "errorCodes": {"400": "VALIDATION_ERROR", "401": "UNAUTHORIZED", "404": "NOT_FOUND", "409": "CONFLICT", "413": "PAYLOAD_TOO_LARGE", "500": "INTERNAL_ERROR"},
    "testCommand": "npm run test:api"
  },
  "core": {
    "domain": ["OwnedEntity", "AppError"],
    "repository": "BaseRepository<TEntity>",
    "service": "BaseService<TEntity, TRepository>",
    "controller": "BaseController<TService>",
    "http": ["errorHandler", "requirePrincipal"],
    "dynamo": "createDynamoClient"
  },
  "moduleConvention": {
    "required": ["domain/", "repository/", "services/", "controllers/", "dto/input.ts", "dto/output.ts", "dto/adapter.ts", "routes/", "module.ts", "index.ts"],
    "externalImport": "Somente o index.ts público de outro módulo.",
    "composition": "module.ts cria repository, service, controller e router; index.ts exporta contrato de service e factory.",
    "validationCommand": "npm run check:modules"
  },
  "modules": [
    {
      "id": "notes",
      "path": "apps/api/src/modules/notes",
      "status": "partial",
      "serviceContract": "NotesService",
      "serviceImplementation": "NotesServiceImpl",
      "repository": "DynamoNotesRepository",
      "publicEntry": "apps/api/src/modules/notes/index.ts",
      "httpContract": "apps/api/src/modules/notes/contract.ts (schemas Zod de saída; importado pelo cliente web; só depende de zod)",
      "routeMount": "disabled-until-auth",
      "operations": ["list", "create", "findById", "update", "delete"],
      "testRepository": "MemoryNotesRepository",
      "persistence": {"table": "NOTES_TABLE_NAME (não criada)", "pk": "USER#<ownerId>", "sk": "NOTE#<id>", "list": "Query pk + begins_with(sk, NOTE#); cursor opaco com o último id", "concurrency": "PutCommand condicional em version", "delete": "DeleteCommand condicional em attribute_exists(pk)"},
      "verification": "2026-10-18: 18 testes — rotas com principal falso (401, CRUD, 404, 409, 413, paginação, isolamento, Zod, formato de erro), repositório DynamoDB com cliente falso e service. Sem DynamoDB real."
    },
    {"id": "events", "status": "planned"},
    {"id": "finance", "status": "planned"},
    {"id": "library", "status": "planned"},
    {"id": "integrations", "status": "planned"},
    {"id": "exports", "status": "planned"}
  ]
}
